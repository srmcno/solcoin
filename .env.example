# --- Required for any credentialed feature ----------------------------------
# Unlocks the encrypted secret store and the wallet keystore. At least 16
# characters. Generate one with: openssl rand -base64 32
# Without it the platform still starts and runs zero-auth research, but no
# credential can be stored or read and no launch can be signed.
SOLCOIN_MASTER_KEY=

# --- Server -----------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=4317
LOG_LEVEL=info

# --- Storage ----------------------------------------------------------------
DATABASE_PATH=./data/solcoin.db
DATA_DIR=./data

# --- Optional ---------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. Leave empty when the
# dashboard is served from this same origin, which is the default.
CORS_ORIGINS=
# Set to true only behind a reverse proxy you control.
TRUST_PROXY=false
# Serve the API without running background jobs (for a read-only replica).
DISABLE_SCHEDULER=false
# Path to the built dashboard. Defaults to packages/web/dist.
WEB_DIST=

# Create the first owner account non-interactively, for headless deployments.
# Omit both to create the account through the dashboard instead.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
