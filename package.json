{
  "name": "solcoin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous AI token launch, research, monitoring and creator-fee platform for Solana / Pump.fun",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build -w @solcoin/shared && npm run build -w @solcoin/server && npm run build -w @solcoin/web",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w @solcoin/server\" \"npm run dev -w @solcoin/web\"",
    "setup": "npm run build && node packages/server/dist/cli/setup.js",
    "start": "node packages/server/dist/main.js",
    "db:migrate": "npm run db:migrate -w @solcoin/server",
    "db:generate": "npm run db:generate -w @solcoin/server",
    "typecheck": "tsc -b packages/shared packages/server packages/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages tests --max-warnings 0",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json,css,md}\"",
    "doctor": "node packages/server/dist/cli/doctor.js",
    "preflight": "npm run build && node packages/server/dist/cli/preflight.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "vite": "^6.4.3"
  }
}
